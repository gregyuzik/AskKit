    "Answers come from Apple's Private Cloud Compute whenever it can serve, and from the on-device model when it can't." : {
      "comment" : "Settings explanation under the Ask status line: which model answers a question, and when.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي الإجابات من Private Cloud Compute من Apple كلما كانت متاحة، ومن النموذج على الجهاز عندما لا تكون متاحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovědi přicházejí z Private Cloud Compute od společnosti Apple, kdykoli je to možné, a jinak z modelu na zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar kommer fra Apples Private Cloud Compute, når den kan svare, og ellers fra modellen på enheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten kommen von Private Cloud Compute von Apple, wann immer es antworten kann, und sonst vom Modell auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answers come from Apple’s Private Cloud Compute whenever it can serve, and from the on-device model when it can’t."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas provienen de Private Cloud Compute de Apple siempre que pueda responder y, si no, del modelo del dispositivo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas provienen de Private Cloud Compute de Apple siempre que pueda responder y, si no, del modelo del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses viennent de Private Cloud Compute d’Apple dès qu’il peut répondre, et sinon du modèle sur l’appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשובות מגיעות מ‑Private Cloud Compute של Apple בכל פעם שהוא זמין, ואחרת מהמודל שבמכשיר."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban berasal dari Private Cloud Compute milik Apple jika tersedia, dan dari model di perangkat jika tidak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte arrivano da Private Cloud Compute di Apple ogni volta che può rispondere, altrimenti dal modello sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答は、AppleのPrivate Cloud Computeが利用できるときはそちらから、利用できないときはデバイス上のモデルから提供されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변은 Apple의 Private Cloud Compute를 사용할 수 있을 때는 거기에서, 그렇지 않을 때는 기기 내 모델에서 제공됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar kommer fra Apples Private Cloud Compute når den kan svare, og ellers fra modellen på enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwoorden komen van Apples Private Cloud Compute wanneer dat kan antwoorden, en anders van het model op het apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedzi pochodzą z Private Cloud Compute firmy Apple, kiedy usługa jest dostępna, a z modelu na urządzeniu, gdy nie jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas vêm do Private Cloud Compute da Apple sempre que ele puder responder e, caso contrário, do modelo no dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы приходят из Private Cloud Compute от Apple, когда он доступен, а иначе — от модели на устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar kommer från Apples Private Cloud Compute när det kan svara, annars från modellen på enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำตอบมาจาก Private Cloud Compute ของ Apple เมื่อใช้งานได้ และมาจากโมเดลบนอุปกรณ์เมื่อใช้งานไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtlar, yanıt verebildiği sürece Apple’ın Private Cloud Compute hizmetinden, veremediğinde ise aygıttaki modelden gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відповіді надходять від Private Cloud Compute компанії Apple, коли сервіс доступний, а якщо ні, то від моделі на пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câu trả lời đến từ Private Cloud Compute của Apple bất cứ khi nào nó có thể phục vụ, và từ mô hình trên thiết bị khi không thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要 Private Cloud Compute 可用，回答就来自 Apple 的 Private Cloud Compute；否则来自设备端模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要Private Cloud Compute可用，回答就來自Apple的Private Cloud Compute；否則來自裝置端模型。"
          }
        }
      }
