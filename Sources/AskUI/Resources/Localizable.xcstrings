    "Answer ready. It read your words only." : {
      "comment" : "Spoken by VoiceOver when an Ask answer has finished arriving for a question the reader asked with a photo, and the model that answered did not see the photo: the on-device model reads no photos, and the app can answer on its own. Says in speech what the note under the question says on screen (\"This answer read your words only.\"). \"It\" is the answer; \"your words\" are the words the reader typed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإجابة جاهزة. اعتمدت هذه الإجابة على كلماتك فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpověď je připravena. Tato odpověď vycházela pouze z vašich slov."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaret er klart. Dette svar læste kun dine ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwort bereit. Diese Antwort hat nur deine Worte gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respuesta lista. Esta respuesta solo ha leído tus palabras."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respuesta lista. Esta respuesta solo leyó tus palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponse prête. Cette réponse ne s’appuie que sur le texte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשובה מוכנה. התשובה הזו התבססה רק על המילים."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban siap. Jawaban ini hanya membaca kata-kata Anda."
