    "Your last chat couldn't be opened. It's been kept, and will come back if it can be read later." : {
      "comment" : "Banner over the empty Ask screen when the chat saved on the device could not be read on this launch.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر فتح آخر دردشة. تم الاحتفاظ بها، وستعود إذا أمكن قراءتها لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš poslední chat se nepodařilo otevřít. Zůstal uložený a vrátí se, pokud ho bude možné později přečíst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din seneste chat kunne ikke åbnes. Den er gemt og kommer tilbage, hvis den kan læses senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein letzter Chat konnte nicht geöffnet werden. Er wurde aufbewahrt und kommt zurück, falls er später gelesen werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your last chat couldn’t be opened. It’s been kept, and will come back if it can be read later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido abrir tu último chat. Se ha guardado y volverá a aparecer si se puede leer más adelante."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir tu último chat. Se guardó y volverá a aparecer si se puede leer más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dernière discussion n’a pas pu être ouverte. Elle a été conservée et reviendra si elle peut être lue plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לפתוח את הצ׳אט האחרון. הוא נשמר, ויחזור אם יהיה אפשר לקרוא אותו מאוחר יותר."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrolan terakhir Anda tidak dapat dibuka. Obrolan itu disimpan dan akan muncul kembali jika dapat dibaca nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile aprire la tua ultima chat. È stata conservata e tornerà se potrà essere letta in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のチャットを開けませんでした。チャットは保存されており、後で読み込めるようになると再び表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 채팅을 열 수 없습니다. 채팅은 보관되어 있으며, 나중에 읽을 수 있게 되면 다시 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den siste chatten din kunne ikke åpnes. Den er tatt vare på og kommer tilbake hvis den kan leses senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je laatste chat kon niet worden geopend. Hij is bewaard en komt terug als hij later kan worden gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się otworzyć ostatniego czatu. Został zachowany i wróci, jeśli da się go później odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir sua última conversa. Ela foi guardada e vai voltar se puder ser lida mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть Ваш последний чат. Он сохранён и вернётся, если его удастся прочитать позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din senaste chatt kunde inte öppnas. Den har sparats och kommer tillbaka om den kan läsas senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดแชทล่าสุดของคุณไม่ได้ ระบบเก็บแชทไว้ให้แล้วและจะกลับมาแสดงเมื่ออ่านได้ภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son sohbetiniz açılamadı. Saklandı ve daha sonra okunabilirse geri gelecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
