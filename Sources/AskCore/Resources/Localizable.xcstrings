    "This conversation got too long to carry on. Start a new chat and ask again." : {
      "comment" : "Shown when an Ask conversation overflowed the model's context window. New Chat is the toolbar button that starts over.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المحادثة طويلة جدًا ولا يمكن متابعتها. يمكنك بدء دردشة جديدة وطرح السؤال مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato konverzace je příliš dlouhá, aby mohla pokračovat. Začněte nový chat a zeptejte se znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne samtale blev for lang til at fortsætte. Start en ny chat, og spørg igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Unterhaltung ist zu lang geworden. Starte einen neuen Chat und frag erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversación se ha hecho demasiado larga para continuar. Empieza un nuevo chat y vuelve a preguntar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversación se hizo demasiado larga para continuar. Empieza un nuevo chat y vuelve a preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette conversation est devenue trop longue pour continuer. Démarrez une nouvelle discussion et posez à nouveau votre question."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השיחה הזו נעשתה ארוכה מדי כדי להמשיך. יש להתחיל צ׳אט חדש ולשאול שוב."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percakapan ini terlalu panjang untuk dilanjutkan. Mulai obrolan baru dan ajukan pertanyaan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa conversazione è diventata troppo lunga per proseguire. Inizia una nuova chat e riprova a chiedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会話は長くなりすぎて続けられません。新規チャットを開始して、もう一度質問してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화가 너무 길어져 이어갈 수 없습니다. 새로운 채팅을 시작해 다시 질문하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne samtalen ble for lang til å fortsette. Start en ny chat, og spør igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit gesprek is te lang geworden om voort te zetten. Begin een nieuwe chat en vraag het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta rozmowa jest zbyt długa, by ją kontynuować. Rozpocznij nowy czat i zapytaj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversa ficou longa demais para continuar. Inicie uma nova conversa e pergunte de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот разговор стал слишком длинным. Начните новый чат и спросите снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här konversationen blev för lång för att fortsätta. Starta en ny chatt och fråga igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสนทนานี้ยาวเกินไปจนไม่สามารถดำเนินต่อได้ เริ่มแชทใหม่แล้วถามอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbet devam edemeyecek kadar uzadı. Yeni bir sohbet başlatıp tekrar sorun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця розмова стала занадто довгою, щоб продовжувати. Почніть новий чат і запитайте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc trò chuyện này đã quá dài để tiếp tục. Hãy bắt đầu cuộc trò chuyện mới và hỏi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这段对话太长，无法继续。请开始新聊天再问一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這段對話太長，無法繼續。請開始新聊天再問一次。"
          }
        }
      }
    },
