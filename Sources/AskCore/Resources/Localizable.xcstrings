    "Apple Intelligence is still downloading. Ask again once it has finished." : {
      "comment" : "Shown when the Apple Intelligence model assets are still downloading.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Apple Intelligence ما زال قيد التنزيل. يمكنك طرح السؤال مرة أخرى بعد اكتمال التنزيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence se ještě stahuje. Zeptejte se znovu, až to bude hotové."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence hentes stadig. Spørg igen, når overførslen er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence wird noch geladen. Frag erneut, sobald der Vorgang abgeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence aún se está descargando. Vuelve a preguntar cuando termine."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
