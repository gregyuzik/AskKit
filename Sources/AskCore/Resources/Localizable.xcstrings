          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence lastes fortsatt ned. Spør igjen når nedlastingen er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
