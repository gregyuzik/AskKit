    "Couldn't answer that just now. Please try again." : {
      "comment" : "Shown when a model was available but the Ask turn timed out, failed, or produced no answer. Retryable, so Try Again is offered.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الرد على ذلك الآن. يرجى المحاولة مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tuto otázku se teď nepodařilo odpovědět. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke svare lige nu. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das konnte gerade nicht beantwortet werden. Versuche es erneut."
          }
        },
        "en" : {
