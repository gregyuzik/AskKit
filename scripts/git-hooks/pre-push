#!/bin/sh
# The push gate: what has to hold before a push leaves the machine. Its checks,
# tests and builds are scripts/ci.sh's, the steps CI runs, so the two gates
# can't drift apart.
#
# In a clone: `git config core.hooksPath scripts/git-hooks`. It needs the tools
# scripts/ci.sh lists, and it runs all of ci.sh on every push. Git ignores a
# hook that isn't executable, so this file stays mode 100755.
#
# It proves the working tree, which the dirty-tree check below makes HEAD's
# tree. It never reads the refs git hands it, so `git push origin other-branch`
# run from here proves HEAD, not other-branch: push a branch from a checkout of
# it.
#
# PREPUSH_LIB, when set, names a shell file this hook sources for a cache of
# trees that have passed. It defines `gate_proven`, which succeeds when the
# tests and builds can be skipped for this tree, and `gate_record`, which notes
# that it passed them, and it reads `gate_irrelevant` below to leave docs out
# of the tree's key. Nothing in this repository provides one; without it the
# gate runs every step.
#
# Order is cheapest-first, so a logic break surfaces in seconds rather than
# after twelve xcodebuilds:
#   1. the dirty-tree check  (what a step reads must be committed, and no
#                             untracked file may sit where a build reads)
#   2. ci.sh checks          (shellcheck, swiftlint, both String Catalog checks,
#                             the README sample's, the project file's)
#   3. ci.sh test            (`swift test`, cold, with a minimum pass count)
#   4. ci.sh builds          (the package for eight destinations)
#   5. ci.sh demo            (the demo's three apps and its UI tests)
# A cache may skip 3 to 5, never the checks. A change to THIS file reaches no
# compiler, but it decides what passing means, so a cache has to count it as a
# change to the tree.
#
# Bypass with `git push --no-verify` (sparingly — fix the underlying issue).

cd "$(git rev-parse --show-toplevel)" || exit 1

# Docs-only: paths that can't reach a compiler. Without this a one-line
# AGENTS.md edit costs twelve xcodebuilds, which is slow enough to train people
# into `--no-verify`, and a push gate that gets routinely bypassed stops gating
# anything. Anything UNKNOWN still falls through to a full run.
#
# A function because a cache (PREPUSH_LIB) reads it too, to key a tree by what
# a compiler can reach. The dirty-tree check below asks a wider question, and
# answers it with `gate_reads`.
#
# No file under a SwiftPM target or one of the demo's folders is docs,
# whatever its extension: SwiftPM takes every file in a target's directory, as
# a source, a resource or an "unhandled file" warning that fails the build, and
# the demo's folders hold its sources and its project
# (Demo/AskKitDemo.xcodeproj/). Demo/'s own top level is no source folder.
gate_irrelevant() {
  case "$1" in
    Sources/*|Tests/*|Demo/*/*) return 1 ;;
    docs/*|.claude/*|.github/*|scripts/git-hooks/*|*.md|.gitignore) return 0 ;;
  esac
  return 1
}

# Whether a step of this gate reads a path from the working tree: everything
# `gate_irrelevant` doesn't call docs, and some files it does, which reach no
# compiler but which a check reads where it stands:
# - README.md, whose Adopt code `ci.sh checks` compares with the README sample
#   files;
# - scripts/git-hooks/*, which git runs from the working tree and check-shell.sh
#   lints there;
# - a tracked `*.sh` anywhere, which check-shell.sh lints, and a `*.swift`
#   anywhere but .claude/, which swiftlint lints.
# Not by widening `gate_irrelevant`: it keys the cache too, and every README
# edit would then cost the full build.
gate_reads() {
  case "$1" in
    README.md|scripts/git-hooks/*|*.sh) return 0 ;;
    .claude/*) return 1 ;;
    *.swift) return 0 ;;
  esac
  ! gate_irrelevant "$1"
}

# Whether a build leaves an untracked path out, whatever ignores it: a hidden
# name (.DS_Store, an editor's swap file), which SwiftPM and Xcode's folders
# skip; xcuserdata/, Xcode's own per-user state; and Demo/Local.xcconfig, the
# signing settings Demo/Signing.xcconfig includes only where one exists.
build_skips() {
  case "$1" in
    */.*|*/xcuserdata/*|Demo/Local.xcconfig) return 0 ;;
  esac
  return 1
}

# Whether an untracked path, which the listings below look for only under
# Sources/, Tests/, Demo/ and at Package.swift, is one a build reads: not one
# the build leaves out, and not docs at Demo/'s own top level, which is no
# source folder.
untracked_builds() {
  ! build_skips "$1" && ! gate_irrelevant "$1"
}

# The newline-separated paths in $2 that the predicate $1 keeps, indented.
keep() {
  printf '%s\n' "$2" | while IFS= read -r f; do
    [ -z "$f" ] || ! "$1" "$f" || printf '  %s\n' "$f"
  done
}

# A tree with uncommitted changes a step reads fails CLOSED, before anything is
# built.
#
# The gate checks and compiles the WORKING TREE, and a cache hashes `HEAD`.
# With uncommitted changes those are different trees, so a dirty push could
# prove a fix that isn't being pushed: a README whose Adopt code matches the
# sample only in the working tree, or a hook fixed there and pushed broken.
# Worse, a cache could record a passing key under the broken commit's hash,
# after which any later push of that exact tree skips the builds entirely, and
# every host that pins this package takes a broken `main` at its next bump.
#
# An untracked file is a change too, where a build reads it: SwiftPM compiles
# every `.swift` in a target's directory, tracked or not, so a commit calling a
# function that lives in an untracked file would pass here and push a tree
# that doesn't compile. Untracked files are looked for only under Sources/,
# Tests/, Demo/ and at Package.swift, so tmp/ and other scratch stay free. An
# ignored file there counts as well: `.git/info/exclude`, a global excludes
# file and an uncommitted `.gitignore` hide a file from git, and none of them
# travels with the push, but SwiftPM and Xcode build what's on disk. So the
# check reads no ignore rule to decide, only `build_skips`, which this file
# carries, and a stray project.pbxproj beside the demo's project.xcproj stops
# the push here, ignored or not. That is also why an uncommitted `.gitignore`
# is no change `gate_reads` counts.
#
# The tracked changes are the working tree against HEAD, staged or not, since
# that difference is the one that matters. `--no-renames` lists a rename as
# its two ends, so a file moved out of Sources/ into docs/ still counts by the
# end the build loses.
#
# Each listing is checked: under /bin/sh a failing git piped into anything
# reads as an empty list, which is a clean tree. `core.quotePath=false` keeps a
# non-ASCII name as it is; a name git still quotes, one with a newline, a tab,
# a quote or a backslash in it, starts with a quote, matches no docs pattern
# and counts, which fails closed.
if ! changed=$(git -c core.quotePath=false diff --name-only --no-renames HEAD --) ||
  ! untracked=$(git -c core.quotePath=false ls-files --others --exclude-standard \
    -- Sources Tests Demo Package.swift) ||
  ! ignored=$(git -c core.quotePath=false ls-files --others --ignored --exclude-standard \
    --directory -- Sources Tests Demo Package.swift); then
  echo "pre-push: git failed to list the tree's changes, so the gate can't tell what it would prove" >&2
  exit 1
fi
dirty_relevant=$(keep gate_reads "$changed")
untracked_relevant=$(keep untracked_builds "$untracked")
ignored_relevant=$(keep untracked_builds "$ignored")
if [ -n "$dirty_relevant" ]; then
  echo "pre-push: changes the gate reads are uncommitted — it would prove a tree you are not pushing:" >&2
  printf '%s\n' "$dirty_relevant" >&2
fi
if [ -n "$untracked_relevant" ]; then
  echo "pre-push: untracked files sit where the build reads them — the gate would build them, and the push would leave them out:" >&2
  printf '%s\n' "$untracked_relevant" >&2
fi
if [ -n "$ignored_relevant" ]; then
  echo "pre-push: ignored files sit where the build reads them — an ignore rule hides them from git, not from SwiftPM or Xcode, so the gate would build them and the push would leave them out:" >&2
  printf '%s\n' "$ignored_relevant" >&2
fi
if [ -n "$dirty_relevant$untracked_relevant$ignored_relevant" ]; then
  echo "pre-push: commit, stash or remove them, then push (git stash -u takes untracked files too, and git stash -a ignored ones)" >&2
  exit 1
fi

if [ -z "${PREPUSH_LIB:-}" ]; then
  echo "pre-push: running scripts/ci.sh, the steps CI runs; with no cache (PREPUSH_LIB), every step runs" >&2
  exec ./scripts/ci.sh all
fi

# shellcheck source=/dev/null
. "$PREPUSH_LIB"

# A caller that can run two pushes in this repo at once sets PREPUSH_SLOT_SUFFIX:
# empty for the first, which keeps the warm caches, and "-2" for one that starts
# while the first runs. Each gets a scratch, logs and DerivedData of its own, so
# neither clobbers the other's.
ASKKIT_CI_WORK="${TMPDIR%/}/askkit-gate${PREPUSH_SLOT_SUFFIX:-}"
export ASKKIT_CI_WORK

./scripts/ci.sh checks || exit 1

# Only the steps whose inputs are in the key are skipped. The checks above have
# already run, and they are the half `--no-verify` throws away.
if gate_proven; then
  echo "pre-push: ok" >&2
  exit 0
fi

./scripts/ci.sh test || exit 1
./scripts/ci.sh builds || exit 1
./scripts/ci.sh demo || exit 1

gate_record
echo "pre-push: ok" >&2
