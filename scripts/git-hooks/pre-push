#!/bin/sh
# shellcheck disable=SC2034,SC2154
#   GATE_NAME and GATE_OWN_PROJECTS are read by the step helpers PREPUSH_LIB
#   sources, and gate_arm_ui and gate_locked_udid are set by them: a library
#   the linter can't follow.
#
# The push gate: what has to hold before a push leaves the machine. Its checks,
# tests and builds are scripts/ci.sh's, the steps CI runs, so the two gates
# can't drift apart. One check is the gate's alone: the String Catalogs graded
# against the standard the maintainers' apps share (`gate_catalogs`, below),
# whose checker CI can't reach.
#
# In a clone: `git config core.hooksPath scripts/git-hooks`. It needs the tools
# scripts/ci.sh lists, and it runs `ci.sh all` on every push. Git ignores a
# hook that isn't executable, so this file stays mode 100755.
#
# It proves the working tree. It never reads the refs git hands it, so `git
# push origin other-branch` run from here proves HEAD, not other-branch: push a
# branch from a checkout of it.
#
# PREPUSH_LIB, when set, names the shell library the maintainers' gates share,
# with step helpers beside it; nothing in this repository provides one.
# Without it the gate runs `ci.sh all`, the steps CI runs,
# scripts/check-strings.py among them, and nothing grades the catalogs'
# translations or runs the iOS steps, which need its seat lock. With it a push
# is light or full. A light one, a backup of work in progress, runs the checks
# and the catalogs and stops. A full one first refuses a working tree that
# isn't what the push sends: an uncommitted change to a path a step reads, an
# untracked file there, or an ignored file where a build reads
# (gate_build_roots), since an ignore rule hides a file from git, not from
# SwiftPM or Xcode. Then it runs every step, unless this exact tree passed
# before or the change reaches no compiler (gate_proven), and records the pass
# (gate_finish). Each step is marked for the gate's timings (gate_step). The
# helpers are documented where the library defines them.
#
# Order is cheapest-first, so a logic break surfaces in seconds rather than
# after a dozen xcodebuilds:
#   1. ci.sh checks          (shellcheck, actionlint and zizmor, swiftlint, the
#                             strings' lookups and count keys, the README
#                             sample's, the project file's)
#   2. gate_catalogs         (the String Catalogs against the shared standard)
#   3. ci.sh test            (`swift test`, cold, with a minimum count)
#   4. ci.sh api             (the public API against the newest release tag)
#   5. ci.sh builds          (the package for eight destinations)
#   6. ci.sh demo            (the demo's three apps and its UI tests, built)
#   7. ci.sh build-ios-tests (the package's tests, built for an iPhone seat)
#      ci.sh build-ui-smoke  (the demo's UI tests, built for it, when 9 runs)
#   8. ci.sh test-ios        (those tests on the seat, which the gate holds
#                             from here)
#   9. ci.sh ui-smoke        (the demo's UI tests on it, when the push changes
#                             Sources/AskUI/ or Demo/)
# Steps 2 to 9 need PREPUSH_LIB. A cache may skip 3 to 9, never the checks. A
# change to THIS file reaches no compiler, but it decides what passing means,
# so a cache has to count it as a change to the tree. The release tag `api`
# compares with is no part of the tree, so a tree that passed stays passed
# when a new tag is cut; CI, which has no cache, still compares it with the
# new one.
#
# Bypass with `git push --no-verify` (sparingly — fix the underlying issue).

cd "$(git rev-parse --show-toplevel)" || exit 1

# Docs-only: paths that can't reach a compiler. Without this a one-line
# AGENTS.md edit costs a dozen xcodebuilds, which is slow enough to train
# people into `--no-verify`, and a push gate that gets routinely bypassed stops
# gating anything. Anything UNKNOWN still falls through to a full run.
#
# A function because the library reads it, to key a tree by what a compiler
# can reach and to tell which steps a branch's diff needs (gate_arms, below).
# The refusal of uncommitted changes asks a wider question, and answers it
# with `gate_reads`.
#
# No file under a SwiftPM target or one of the demo's folders is docs,
# whatever its extension: SwiftPM takes every file in a target's directory, as
# a source, a resource or an "unhandled file" warning that fails the build, and
# the demo's folders hold its sources and its project
# (Demo/AskKitDemo.xcodeproj/). Demo/'s own top level is no source folder.
#
# Nor is the API allowlist, though it sits under .github/: `ci.sh api` reads
# it, so emptying it, with nothing else changed, can fail that step, and a
# cache that left it out of the key would skip the step on the strength of the
# list before.
#
# Nor is this hook, which reaches no compiler either: it decides what passing
# means (above), so a cache that left it out of the key would count a tree as
# passed under the gate it replaced. It falls through to the default, as
# scripts/ci.sh does.
gate_irrelevant() {
  case "$1" in
    Sources/*|Tests/*|Demo/*/*|.github/api-breakage-allowlist.txt) return 1 ;;
    docs/*|.claude/*|.github/*|*.md|.gitignore) return 0 ;;
  esac
  return 1
}

# Whether a step of this gate reads a path from the working tree: everything
# `gate_irrelevant` doesn't call docs, this hook included, which git runs from
# the working tree and check-shell.sh lints there, and some files it does call
# docs, which reach no compiler but which a check reads where it stands:
# - README.md, whose Adopt code `ci.sh checks` compares with the README sample
#   files;
# - a tracked `*.sh` anywhere, which check-shell.sh lints, and a `*.swift`
#   anywhere but .claude/, which swiftlint lints;
# - the workflows, the setup action, Dependabot's config and the two linters'
#   configs, which actionlint and zizmor read.
# Not by widening `gate_irrelevant`: it keys the cache too, and every README
# edit would then cost the full build. An uncommitted `.gitignore` is no change
# this counts: what it hides is still on disk, and the ignored files there are
# gate_build_roots' to refuse.
gate_reads() {
  case "$1" in
    README.md|*.sh) return 0 ;;
    .github/workflows/*|.github/actions/*|.github/dependabot.yml) return 0 ;;
    .github/actionlint.yaml|.github/zizmor.yml) return 0 ;;
    .claude/*) return 1 ;;
    *.swift) return 0 ;;
  esac
  ! gate_irrelevant "$1"
}

# CI checks out a clean tree and has no cache to record a pass in, so without
# the library nothing is refused: the steps run on the working tree as it is.
if [ -z "${PREPUSH_LIB:-}" ]; then
  echo "pre-push: running scripts/ci.sh all, the steps CI runs; with no PREPUSH_LIB there is no cache, so all of them run, with no shared String Catalog checker and no iOS tests, which need its seat lock" >&2
  exec ./scripts/ci.sh all
fi

# The cache prefix the step helpers name their logs by, and the projects whose
# target-level warnings ("(in target 'X' from project 'P')") are AskKit's, as
# ci.sh's own matcher has them.
GATE_NAME=askkit
GATE_OWN_PROJECTS='AskKit|AskKitDemo'

# shellcheck source=/dev/null
. "$PREPUSH_LIB"

# The folders a build reads whole: the package's targets, every folder of the
# demo's (`Demo/*/*`: its top level holds the untracked Demo/Local.xcconfig a
# developer keeps their signing team in, and reads nothing else), and the
# manifest. A file an ignore rule hides there (`.git/info/exclude`, a global
# excludes file, an uncommitted `.gitignore`) would be built and left out of
# the push, a stray project.pbxproj beside the demo's project.xcproj among
# them. Hidden names and xcuserdata/ don't count.
gate_build_roots Sources Tests 'Demo/*/*' Package.swift || exit 1

# A caller that can run two pushes in this repo at once sets PREPUSH_SLOT_SUFFIX:
# empty for the first, which keeps the warm caches, and "-2" for one that starts
# while the first runs. Each gets a scratch, logs and DerivedData of its own, so
# neither clobbers the other's.
tmp=$(gate_tmp) || exit 1
ASKKIT_CI_WORK="${tmp}askkit-gate${PREPUSH_SLOT_SUFFIX:-}"
export ASKKIT_CI_WORK
derived="$ASKKIT_CI_WORK/derived"

gate_step "ci.sh checks"
./scripts/ci.sh checks || exit 1
gate_catalogs || exit 1

# Only the steps whose inputs are in the key are skipped. The checks above have
# already run, and they are the half `--no-verify` throws away.
if gate_proven; then exit 0; fi

# From here a failure ends the gate through gate_finish, which lets go of the
# DerivedData the builds claimed.
gate_step "ci.sh test"
./scripts/ci.sh test || gate_finish --failed
gate_step "ci.sh api"
./scripts/ci.sh api || gate_finish --failed

# The builds share one DerivedData, kept warm between pushes, where a warning
# in a file nothing recompiles would stay hidden. So each build's output is
# counted for AskKit's warnings too, and a run that printed one leaves the
# DerivedData marked: the next run starts it empty.
gate_logged --warnings "$derived" "ci.sh builds" ./scripts/ci.sh builds || gate_finish --failed
gate_logged --warnings "$derived" "ci.sh demo" ./scripts/ci.sh demo || gate_finish --failed

# The UI smoke suite (about 12 minutes, and the flakiest step there is) only
# when the push changes the screen, a file under Sources/AskUI/ or Demo/ (its
# docs aside) that differs from where the branch left main, or the script that
# runs the suite. With no merge base, or a change to this gate, it runs.
#
# A tree that passes with the suite skipped is still recorded, so a later push
# of the same tree skips the suite too, even where main has moved and its
# screen now differs (a revert of a screen change, say). Such a tree's screen
# is one main shipped, and recording only the runs that ran the suite would
# rebuild every logic-only tree at every landing.
gate_map() {
  case "$1" in
    Sources/AskUI/*|Demo/*|scripts/ci.sh|scripts/ui-smoke.sh) echo ui ;;
  esac
}
gate_arms gate_map ui || gate_finish --failed

# The iOS steps CI can't run, since its virtual Mac draws views too slowly for
# the suites' deadlines, so this gate is where they run. Their tests are built
# for the iPhone seat it picks before it locks one, so the seat (a simulator
# runs one test session at a time, and the lock is shared with every repo's
# gate and with hand-held seats) is held only while they run.
sim=$(gate_sim "iPhone 18 Pro") || gate_finish --failed
ASKKIT_SIM=$sim
export ASKKIT_SIM
gate_logged --warnings "$derived" "ci.sh build-ios-tests" ./scripts/ci.sh build-ios-tests || gate_finish --failed
if [ "$gate_arm_ui" = 1 ]; then
  gate_logged --warnings "$derived" "ci.sh build-ui-smoke" ./scripts/ci.sh build-ui-smoke || gate_finish --failed
fi

# The lock may move the gate to the other iPhone, when the one it picked is
# held by hand; the tests run on the one it holds. The seat goes back as the
# lock found it when the gate lets it go or exits: shut down again if it was
# down and no test run is live on it.
gate_step "simulator lock"
gate_lock_sim "$sim" --either
ASKKIT_SIM=${gate_locked_udid:-$sim}
ASKKIT_TESTS_BUILT=1
export ASKKIT_SIM ASKKIT_TESTS_BUILT

gate_step "ci.sh test-ios"
./scripts/ci.sh test-ios || gate_finish --failed
if [ "$gate_arm_ui" = 1 ]; then
  gate_step "ci.sh ui-smoke"
  ./scripts/ci.sh ui-smoke || gate_finish --failed
else
  echo "pre-push: ui-smoke skipped: nothing under Sources/AskUI/ or Demo/, and no script that runs it, changed since main" >&2
fi
gate_release_sim

gate_finish
echo "pre-push: ok" >&2
