{
  "default-configuration": "Debug",
  "configurations": [
    { "name": "Debug", "file": "Configuration/Signing.xcconfig" },
    { "name": "Release", "file": "Configuration/Signing.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "..",
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "AskKitDemo",
      "target-membership": [
        "AskKitDemo_iOS",
        "AskKitDemo_macOS",
        "AskKitDemo_visionOS",
      ],
      "membership-exceptions": [
        {
          "target": "AskKitDemo_iOS",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "AskKitDemo_macOS",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "AskKitDemo_visionOS",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "AskKitDemoUITests", "target-membership": [ "AskKitDemoUITests" ] },
    {
      "kind": "group",
      "name": "Packages",
      "children": [
        { "path": "<PROJECT>/.." },
      ],
    },
    { "kind": "folder", "path": "Shared", "target-membership": [ "AskKitDemoUITests", "AskKitDemo_iOS", "AskKitDemo_macOS", "AskKitDemo_visionOS" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/AskKitDemo.app", "id": "2A072404FA1C35F2B504A75C", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AskKitDemo.app", "id": "2904970E1D5BEB6D41DC5458", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AskKitDemo.app", "id": "FA5D12B93E570EBD71A3B4C2", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AskKitDemoUITests.xctest", "id": "6CEDB43B02A0CE2104A75394", "type": "wrapper.cfbundle", "index": false },
      ],
    }, {
      "kind": "group",
      "name": "Configuration",
      "children": [
        { "path": "Signing.xcconfig" },
      ],
    },
  ],
  "targets": [
    {
      "name": "AskKitDemo_iOS",
      "id": "C4DB016DC66930D265DC069D",
      "product": "id:2A072404FA1C35F2B504A75C",
      "product-type": "application",
      "legacy-team-id": "",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "AskCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "AskUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "AskKitDemo/AskKitDemo_iOS.entitlements",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "ENABLE_ENHANCED_SECURITY": "YES",
        "INFOPLIST_FILE": "AskKitDemo/Info.plist",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.example.askkitdemo$(DEMO_BUNDLE_ID_SUFFIX)",
        "PRODUCT_NAME": "AskKitDemo",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "AskKitDemo_macOS",
      "id": "26AEB2B9009820D432D8724D",
      "product": "id:2904970E1D5BEB6D41DC5458",
